        [ -z "$anime_list" ] && die "No unwatched series in history!"
        [ -z "${index##*[!0-9]*}" ] && id=$(printf "%s" "$anime_list" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select anime: " | cut -f1)
        [ -z "${index##*[!0-9]*}" ] || id=$(printf "%s" "$anime_list" | sed -n "${index}p" | cut -f1)
        [ -z "$id" ] && exit 1
        title=$(printf "%s" "$anime_list" | grep -F "$id" | cut -f2 | sed 's/ - episode.*//')
        episode_maps=$(hianime_episodes "$id") || exit 1
        ep_list=$(printf "%s" "$episode_maps" | cut -f2)
        ep_no=$(printf "%s" "$anime_list" | grep -F "$id" | cut -f2 | sed -nE 's/.*- episode (.+)$/\1/p')
        anime_title="$(printf "%s" "$title" | cut -d'(' -f1 | tr -d '[:punct:]')"
        [ "$player_function" = "download" ] && prepare_download_dir
        printf "%s" "$anime_list" | grep -F "$id" | cut -f2 | grep -q "(up to date)" && time_until_next_ep "$anime_title"
        ;;
    *)
        if [ "$menu_program" = "fzf" ]; then
            while [ -z "$query" ]; do
                printf "\33[2K\r\033[1;36mSearch anime: \033[0m" && read -r query
            done
        else
            [ -z "$query" ] && query=$(: | menu "Search anime: " "" "$menu_extra_flags")
            [ -z "$query" ] && exit 1
        fi
        # for checking new releases by specifying anime name
        [ "$search" = "nextep" ] && time_until_next_ep "$query"

        _page="${page:-1}"
        _results=""
        while :; do
            _page_results="$(hianime_search "$query" "$_page")" || exit 1
            # results repeat across page boundaries: keep only the first occurrence
            _results="$(printf "%s\n%s\n" "$_results" "$_page_results" | sed '/^$/d' | awk -F'\t' '!seen[$1]++')"
            [ -z "$_results" ] && die "No results found!"
            # check if select-nth index is a valid number, if so skip interactive selection
            if [ "$index" -eq "$index" ] 2>/dev/null; then
                result="$(printf "%s" "$_results" | sed -n "${index}p")"
                break
            fi
            _has_next="$(hianime_has_next "$_page_results" "$_page")"
            result="$(printf "%s" "$_results" | search_pick "$_has_next")"
            case "$result" in
                *load_more_page*) _page=$((_page + 1)); continue ;;
            esac
            break
        done
        [ -z "$result" ] && die "Invalid/No Anime Selection"
        title="$(printf "%s" "$result" | cut -f2)"
        anime_title="$(printf "%s" "$title" | cut -d'(' -f1 | tr -d '[:punct:]')"
        id="$(printf "%s" "$result" | cut -f1)"
        [ "$player_function" = "download" ] && prepare_download_dir
        episode_maps=$(hianime_episodes "$id") || exit 1
        ep_list=$(printf "%s" "$episode_maps" | cut -f2)
        # -1 (last episode) is always valid; ranges/multiples/decimals are validated by play()
        if [ -n "$ep_no" ] && [ "$ep_no" != "-1" ]; then
            case "$ep_no" in
                *[!0-9]*) ;;                       # range/multi/non-whole: checked in play()
                *) printf "%s" "$ep_list" | grep -q "^$ep_no$" || die "Invalid Episode Selection" ;;
            esac
        fi
        [ -z "$ep_no" ] && ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$menu_multi_flag")
        [ -z "$ep_no" ] && die "Invalid/No Episode Selection"
        ;;
esac

# moves the cursor up one line and clears that line
tput cuu1 2>/dev/null && tput el 2>/dev/null
# stores the position of cursor
tput sc 2>/dev/null

# playback & loop
play
[ "$player_function" = "download" ] && exit 0
[ "$player_function" = "debug" ] && exit 0

while cmd=$(printf 'next\nreplay\nprevious\nselect\nchange_quality\nquit' | nth "Playing episode $ep_no of $title... "); do
    # save playback position before acting on the menu choice
    if [ "$menu_program" = "fzf" ]; then
        case "$player_function" in
            mpv*|flatpak_mpv) update_history "$(get_mpv_position)" ;;
        esac
    fi
    case "$cmd" in
        next) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}" 2>/dev/null) ;;
        replay) episode="$replay" ;;
        previous) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{g;1!p;};h" 2>/dev/null) ;;
        select) ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$menu_multi_flag") ;;
        change_quality)
            new_quality="$(printf "%s" "$links" | menu | cut -d">" -f1)"
            [ -z "$new_quality" ] && die "No quality selected"
            select_quality "$new_quality"
            ;;
        *)
            cleanup
            exit 0
            ;;
    esac
    [ -z "$ep_no" ] && die "Out of range"
    play
done
cleanup

