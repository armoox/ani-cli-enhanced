version_info() {
    printf "%s\n" "$version_number"
    exit 0
}

update_script() {
    info "[branch:$branch] Checking for Update.."
    update="$(curl --fail-with-body -sL -A "$agent" "https://raw.githubusercontent.com/armoox/ani-cli-fork/$branch/ani-cli")" || die "[branch:$branch] Connection error: $update"
    new_version="$(printf "%s" "$update" | sed -nE 's|^version_number="([^"]+)"$|\1|p')"
    [ -z "$new_version" ] && die "[branch:$branch] Invalid response."
    printf "%s" "$update" | grep -q "^version_number" || die "[branch:$branch] Invalid Response."
    update="$(printf "%s\n" "$update" | diff -u "$0" -)"
    if [ -z "$update" ]; then
        info "[branch:$branch] Script is up to date :) ($version_number)"
    else
        if printf "%s\n" "$update" | patch "$0" -; then
            info "[branch:$branch] Updated: $version_number -> $new_version"
        else
            die "[branch:$branch] Can't update for some reason!"
        fi
    fi
    exit 0
}

# checks if dependencies are present
dep_ch() {
    for dep; do
        command -v "${dep%% *}" >/dev/null || die "Program \"${dep%% *}\" not found. Please install it."
    done
}

dep_ch_failover() {
    [ -z "$1" ] && return 1
    prog=$(printf "%s" "$1" | cut -d"," -f 1)
    rest=$(printf "%s" "$1" | cut -s -d"," -f 2-)
    command -v "$prog" >/dev/null 2>&1 && printf "%s" "$prog" && return 0
    [ -e "$prog" ] && printf "%s" "$prog" && return 0
    dep_ch_failover "$rest"
}

where_iina() {
    [ -e "/Applications/IINA.app/Contents/MacOS/iina-cli" ] && printf "%s" "/Applications/IINA.app/Contents/MacOS/iina-cli" && return 0
    printf "%s" "iina" && return 0
}

where_mpv() {
    command -v "flatpak" >/dev/null && flatpak info io.mpv.Mpv >/dev/null 2>&1 && printf "%s" "flatpak_mpv" && return 0
    printf "%s" "mpv" && return 0
}

cleanup() {
    tput sgr0 2>/dev/null          # clears colors
    # remove temp logfile, stale mpv ipc socket, skip script and history lock
    rm -f "${histfile}.new" "${histfile}.lock" "/tmp/ani-cli-mpv-$$" "/tmp/ani-cli-skip-$$.lua"
}

# SCRAPING

#shellcheck disable=SC2086
hianime_curl() {
    _curl_status=0
    _response="$($curl_exe -sL -A "$agent" --max-time 10 $cipher_flag \
        -w ' %{http_code}' "$@")" || _curl_status=$?

    _http_code=${_response##* }
    _response=${_response% *}

    if [ "$_curl_status" -ne 0 ]; then
        case "$_http_code" in
            [1-5][0-9][0-9]) _detail="HTTP $_http_code" ;;
            *) _detail="no HTTP response" ;;
        esac
        die "Connection error: could not fetch $1 ($_detail; curl exit $_curl_status)"
    fi

    case "$_http_code" in
        2??) ;;
        *) printf "%s" "$_response" | grep -qi "Just a moment" ||
            die "Request failed: HTTP $_http_code from $1" ;;
    esac

    printf "%s" "$_response"
}

# GNU, BSD and openssl spell base64 decoding differently
b64_decode() {
    printf "%s\n" "$1" | base64 -d 2>/dev/null || printf "%s\n" "$1" | base64 -D 2>/dev/null || printf "%s\n" "$1" | openssl base64 -d -A 2>/dev/null
}

# percent-encode whitespace and common url-unsafe characters
urlencode() {
    printf "%s" "$1" | tr ' ' '+' | sed -e 's|&|%26|g' -e 's|=|%3D|g' -e "s|'|%27|g" -e 's|"|%22|g' -e 's|#|%23|g' -e 's|?|%3F|g' -e 's|/|%2F|g' -e 's|\||%7C|g'
}

# the embed page ships its config as base64(json XOR "otaku-embed-v1"), this prints the json.
# runs in a subshell so the key bytes can live in the positional parameters and rotate with shift.
deobfuscate_blob() (
    _bytes="$(b64_decode "$1" | od -v -An -tu1)"
    set -- 111 116 97 107 117 45 101 109 98 101 100 45 118 49
    _output=""
    for _byte in $_bytes; do
        _char=$((_byte ^ $1))
        _output="${_output}\\0$((_char / 64))$(((_char / 8) % 8))$((_char % 8))"
        set -- "$@" "$1"
        shift
    done
    printf "%b" "$_output"
)

# search query $1 on page ${2:-1}: 30 results, format is (id \t title \t type \t duration).
# type/duration come from the fd-infor spans and let a search present films, OVAs, etc.
hianime_search() {
    #shellcheck disable=SC2059
    _page="$(hianime_curl "$(printf "$search_api" "$(urlencode "$1")" "${2:-1}")")" || return 1
    if printf "%s" "$_page" | grep -qi "<title>Just a moment"; then
        [ "$curl_exe" = "curl" ] && die "Blocked by cloudflare. Try installing curl-impersonate"
        die "Blocked by cloudflare."
    fi
    # the top-10 sidebar repeats the result markup, cut it off before flattening the page
    printf "%s" "$_page" | sed '/id="main-sidebar"/,$d' | tr '\n' ' ' | sed 's|<div class="film-detail">|\n<div class="film-detail">|g' |
        awk '
            {
                b = $0
                slug = ""; t = ""; ty = ""; du = ""
                if (match(b, /href="[^"]*"/)) {
                    u = substr(b, RSTART + 6, RLENGTH - 7)
                    p = 0
                    for (;;) { q = index(substr(u, p + 1), "/"); if (q == 0) break; p = p + q }
                    slug = substr(u, p + 1)
                }
                if (slug ~ /\./) next
                p = index(b, "title=\"")
                if (p > 0) {
                    q = index(substr(b, p + 7), "\"")
                    t = substr(b, p + 7, q - 1)
                }
                p = index(b, "<span class=\"fdi-item\">")
                if (p > 0) {
                    q = index(substr(b, p + 23), "</span>")
                    ty = substr(b, p + 23, q - 1)
                }
                p = index(b, "class=\"fdi-item fdi-duration\">")
                if (p > 0) {
                    q = index(substr(b, p + 30), "</span>")
                    du = substr(b, p + 30, q - 1)
                }
                if (ty == "" && du == "") next
                if (t == "" || slug == "") next
                print slug "\t" t "\t" ty "\t" du
            }
        ' |
        sed -e "s|&#039;|'|g" -e 's|&quot;|"|g' -e "s|&amp;|\&|g"
}

# print 1 if search page $2's html $1 has a following page, nothing otherwise
hianime_has_next() {
    _cur="${2:-1}"
    _next="$(printf "%s" "$1" | grep -o 'title="Next" class="page-link" href="[^"]*"' | sed -nE 's|.*page=([0-9]+)|\1|p')"
    [ -n "$_next" ] && [ "$_next" -gt "$_cur" ]
}

# pick an anime from enhanced search results (id \t title \t type \t duration).
# the id is hidden from the menu so the ranking looks clean; the picked
# display line is mapped back to its row.  appends a "load more" entry to
# page within the search when $1 is non-empty.
search_pick() {
    _input=$(cat -)
    [ -z "$_input" ] && return 1
    _count="$(printf "%s\n" "$_input" | wc -l | tr -d "[:space:]")"
    [ "$_count" -eq 1 ] && printf "%s" "$_input" && return 0
    _multi=""
    [ $# -ge 2 ] && _multi="$2"
    _display="$(printf "%s\n" "$_input" | awk -F'\t' '{
        line = $2
        if ($3 != "" || $4 != "") {
            line = line " ["
            if ($3 != "") line = line $3
            if ($4 != "") { if ($3 != "") line = line " | "; line = line $4 }
            line = line "]"
        }
        print line
    }')"
    [ -n "$1" ] && _display="$(printf "%s\n%s" "$_display" "load_more_page  ▶ Load more results")"
    _picked="$(printf "%s\n" "$_display" | menu "Select anime: " "$_multi" "$menu_extra_flags")"
    [ -n "$_picked" ] || return 1
    while IFS= read -r _line; do
        case "$_line" in
            load_more_page*) printf "%s\n" "load_more_page" ;;
            *)
                # map the picked display line back to the full result row
                _sought="$(printf "%s" "$_line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
                printf "%s\n" "$_input" | awk -F'\t' -v want="$_sought" '
                    {
                        line = $2
                        if ($3 != "" || $4 != "") {
                            line = line " ["
                            if ($3 != "") line = line $3
                            if ($4 != "") { if ($3 != "") line = line " | "; line = line $4 }
                            line = line "]"
                        }
                        if (line == want) print
                    }'
                ;;
        esac
    done <<EOF
$(printf "%s" "$_picked")
EOF
}

# get the episodes list of the selected anime. format is (id \t ep_no)
hianime_episodes() {
    #shellcheck disable=SC2059
    _page="$(hianime_curl "$(printf "$episodes_api" "${1##*-}")")" || return 1
    # ids from the v5.0 provider have the same shape, so check the slug in the episode links too
    printf "%s" "$_page" | sed 's|\\||g; s|ep-item|\nep-item|g' |
        sed -nE "s|.*data-number=\"([^\"]*)\".*data-id=\"([0-9]+)\".*/watch/${1}[?]ep=.*|\\2\\t\\1|p"
}

hianime_m3u8() {
    _ep_id=$(printf "%s" "$episode_maps" | sed -nE "s|^([0-9]+)\t${1}$|\1|p")
    #shellcheck disable=SC2059
    _servers="$(hianime_curl "$(printf "$servers_api" "$_ep_id")" | sed 's|\\"|"|g; s|server-item|\nserver-item|g')"
    # only the zokoanime embed is understood by deobfuscate_blob, the other servers use different players
    _hash="$(printf "%s\n" "$_servers" | sed -nE 's|.*data-type="'"$2"'".*data-server-name="ZokoAnime".*data-hash="([^"]*)".*|\1|p' | head -n 1)"
    _embed="$(b64_decode "$_hash")"
    [ -z "$_embed" ] && return 1
    # the stream host wants the embed site as referer, and the embed url carries the mal id for ani-skip
    refr="$(printf "%s" "$_embed" | sed -E 's|^(https?://[^/]*).*|\1/|')"
    mal_id="$(printf "%s" "$_embed" | sed -nE 's|.*/mal/([0-9]+)/.*|\1|p')"
    _blob="$(hianime_curl "$_embed" | sed -nE 's|.*window\.__P="([^"]*)".*|\1|p')"
    [ -z "$_blob" ] && return 1
    _json="$(deobfuscate_blob "$_blob")"
    _m3u8_master="$(printf "%s" "$_json" | sed -nE 's|.*"src":"([^"]*\.m3u8[^"]*)".*|\1|p')"
    [ -z "$_m3u8_master" ] && return 1
    # several languages can be listed, the site marks the english track as default
    sub_link="$(printf "%s" "$_json" | sed 's|.*"subtitles":\[||; s|\].*||; s|},{|}\n{|g' | grep -m 1 '"default":true' | sed -nE 's|.*"src":"([^"]*)".*|\1|p')"
    # quality variants are relative to the master playlist
    links="$(hianime_curl "$_m3u8_master" -e "$refr" | sed 's|^#EXT-X-STREAM.*x||g; s|,.*|p|g; /^#/d; $!N; s|\n| >|;/EXT-X-I-FRAME/d' | sed "\|>https*://|!s|>|>${_m3u8_master%/*}/|" | sort -g -r -s)"
    [ -n "$links" ]
}

# select the quality according to the setting
select_quality() {
    case "$1" in
        best) _result=$(printf "%s" "$links" | head -n 1) ;;
        worst) _result=$(printf "%s" "$links" | grep -E '^[0-9]{3,4}' | tail -n 1) ;;
        *) _result=$(printf "%s" "$links" | grep -m 1 "$1") ;;
    esac
    [ -z "$_result" ] && printf "\33[2K\r\033[1;33m%s\033[0m\n" "$1 not found, defaulting to best" >&2 && _result=$(printf "%s" "$links" | head -n 1)

    episode=$(printf "%s" "$_result" | cut -d ">" -f 2)
}

# gets embed url, collects direct links and selects one with desired quality into $episode
get_video_link() {
    hianime_m3u8 "$ep_no" "$mode" || die "No sources found for $mode!"
    info "hianime.at links fetched"
    select_quality "$quality"
    refr_flag="--referrer=$refr"
    # the shard CDN closes keepalive connections (ffmpeg logs "keepalive request
    # failed" and reconnects), so use http_persistent=0 to open a fresh connection
    # per segment (fast, curl-like) and --cache=yes so mpv greedily pre-buffers the
    # whole episode instead of stuttering.
    # the buffer window is symmetric ($ani_cache in both directions): mpv evicts
    # already-played packets from the back buffer once the window fills, so a
    # small --demuxer-max-bytes makes backward seeking fail.  keep both limits on
    # the same budget so you can seek forward AND back through the episode.
    bacc_flag="--cache=yes --stream-lavf-o=http_persistent=0 --demuxer-readahead-secs=60 --demuxer-max-bytes=$ani_cache --demuxer-max-back-bytes=$ani_cache"
    # once the episode is larger than the ram window, the back buffer still gets
    # evicted; spill the packet data to a temp file instead so the whole stream
    # stays seekable both ways regardless of length.
    [ "$disk_cache" = 1 ] && bacc_flag="$bacc_flag --cache-on-disk=yes"
    # should never trigger but just in case
    if printf "%s" "$ep_list" | grep -q "^$ep_no$"; then
        [ -z "$episode" ] && die "Episode is released, but no valid sources!"
    else
        [ -z "$episode" ] && die "Episode not released!"
    fi
}

# build --script/--script-opts flags for mpv intro/outro skipping.
# uses the ani-skip binary when present, otherwise falls back to a bundled mpv
# script and the public aniskip.com API.
skip_opts() {
    [ -n "$mal_id" ] || { warn "Couldn't find the MyAnimeList id of this anime, intro skipping disabled"; return 1; }
    # use the ani-skip binary if installed (it handles the full workflow including fzf)
    if command -v ani-skip >/dev/null 2>&1; then
        _out="$(ani-skip -i "$mal_id" -e "$ep_no" 2>/dev/null)" && printf "%s" "$_out" && return 0
    fi
    # fetch op/ed timestamps from the public aniskip API
    _json="$($curl_exe -sL -A "$agent" --connect-timeout 5 "https://api.aniskip.com/v1/skip-times/${mal_id}/${ep_no}?types=op&types=ed")"
    [ -z "$_json" ] && return 1
    printf "%s" "$_json" | grep -q '"found":true' || { info "No skip times for this episode"; return 1; }
    _op_start="" ; _op_end="" ; _ed_start="" ; _ed_end=""
    _op="$(printf "%s" "$_json" | grep -oE '"interval":\{"start_time":[0-9.]+,"end_time":[0-9.]+\},"skip_type":"op"' | head -n1)"
    _ed="$(printf "%s" "$_json" | grep -oE '"interval":\{"start_time":[0-9.]+,"end_time":[0-9.]+\},"skip_type":"ed"' | head -n1)"
    case "$_op" in *'"skip_type":"op"'*)
        _op_start="$(printf "%s" "$_op" | sed -nE 's|.*"start_time":([0-9.]+).*|\1|p')"
        _op_end="$(printf "%s" "$_op" | sed -nE 's|.*"end_time":([0-9.]+).*|\1|p')"
        ;; esac
    case "$_ed" in *'"skip_type":"ed"'*)
        _ed_start="$(printf "%s" "$_ed" | sed -nE 's|.*"start_time":([0-9.]+).*|\1|p')"
        _ed_end="$(printf "%s" "$_ed" | sed -nE 's|.*"end_time":([0-9.]+).*|\1|p')"
        ;; esac
    _opts=""
    if [ -n "$_op_start" ] && [ -n "$_op_end" ]; then
        _opts="skip-op_start=$_op_start,skip-op_end=$_op_end"
    fi
    if [ -n "$_ed_start" ] && [ -n "$_ed_end" ]; then
        [ -n "$_opts" ] && _opts="$_opts,"
        _opts="$_opts"$(printf "skip-ed_start=%s,skip-ed_end=%s" "$_ed_start" "$_ed_end")
    fi
    [ -z "$_opts" ] && { info "No skip times for this episode"; return 1; }
    # write the bundled mpv script (read once at launch, safe to unlink after)
    _skip_lua="/tmp/ani-cli-skip-$$.lua"
    # shellcheck disable=SC2016
    cat > "$_skip_lua" <<'EOFSKIP'
local mpv = require("mp")
local o = {op_start = 0, op_end = 0, ed_start = 0, ed_end = 0}
require("mp.options").read_options(o, "skip")
local function s()
    local p = mpv.get_property_number("time-pos")
    if not p then return end
    if p >= o.op_start and p < o.op_end then
        mpv.set_property_number("time-pos", o.op_end)
    elseif p >= o.ed_start and p < o.ed_end then
        mpv.set_property_number("time-pos", o.ed_end)
    end
end
mpv.observe_property("time-pos", "number", s)
EOFSKIP
    printf -- "--script=%s --script-opts=%s" "$_skip_lua" "$_opts"
}

time_until_next_ep() {
    animeschedule="https://animeschedule.net"
    query="$(printf "%s\n" "$*" | tr ' ' '+')"
    _routes="$(curl --max-time 5 -s -G "$animeschedule/api/v3/anime" --data "q=${query}" | sed 's|"id"|\n|g' | sed -nE 's|.*,"route":"([^"]*)","premier.*|\1|p')"
    for anime in $_routes; do
        data=$(curl --max-time 5 -s "$animeschedule/anime/$anime" | sed '1,/"anime-header-list-buttons-wrapper"/d' | sed -nE 's|.*countdown-time-raw" datetime="([^"]*)".*|Next Raw Release: \1|p;s|.*countdown-time" datetime="([^"]*)".*|Next Sub Release: \1|p;s|.*english-title">([^<]*)<.*|English Title: \1|p;s|.*main-title".*>([^<]*)<.*|Japanese Title: \1|p')
        status="Ongoing"
        color="33"
        printf "%s\n" "$data"
        ! (printf "%s\n" "$data" | grep -q "Next Raw Release:") && status="Finished" && color="32"
        printf "Status:  \033[1;%sm%s\033[0m\n---\n" "$color" "$status"
    done
    exit 0
}

# PLAYING

process_hist_entry() {
    ep_list=$(hianime_episodes "$id" 2>/dev/null | cut -f 2)
    # skip stale/legacy entries that the current provider can't resolve anymore
    [ -z "$ep_list" ] && return 1
    latest_ep=$(printf "%s\n" "$ep_list" | tail -n1)
    title=$(printf "%s\n" "$title" | sed "s|[0-9]\+ episodes|${latest_ep} episodes|")
    ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}")
    [ -n "$ep_no" ] && printf "%s\t%s - episode %s\n" "$id" "$title" "$ep_no"
    [ -n "$ep_no" ] || printf "%s\t%s - episode %s (up to date)\n" "$id" "$title" "$latest_ep"
}

update_history() {
    _pos="${1:-0}"
    # serialize concurrent history writes (parallel downloads)
    _lock_tries=0
    while ! mkdir "${histfile}.lock" 2>/dev/null; do
        _lock_tries=$((_lock_tries + 1))
        [ "$_lock_tries" -gt 100 ] && return 1
        sleep 0.2
    done
    if grep -q "	${id}	" "$histfile"; then
        awk -F'\t' -v OFS='\t' -v id="$id" -v ep_no="$ep_no" -v title="$title" -v pos="$_pos" '
            $2 == id { $1=ep_no; $3=title; $4=pos }
            { print }
        ' "$histfile" >"${histfile}.new"
    else
        cp "$histfile" "${histfile}.new"
        printf "%s\t%s\t%s\t%s\n" "$ep_no" "$id" "$title" "$_pos" >>"${histfile}.new"
    fi
    mv "${histfile}.new" "$histfile"
    rmdir "${histfile}.lock" 2>/dev/null
}

backup_old_hist() {
    backupfile="${histfile}.v4"
    : >"${histfile}.new"
    while IFS='	' read -r _ep _id _title _pos; do
        case "$_id" in
            *-*) printf "%s\t%s\t%s\t%s\n" "$_ep" "$_id" "$_title" "$_pos" >>"${histfile}.new" ;;
            *) printf "%s\t%s\t%s\t%s\n" "$_ep" "$_id" "$_title" "$_pos" >>"$backupfile" ;;
        esac
    done <"$histfile"
    mv "${histfile}.new" "$histfile"
}

get_mpv_position() {
    _socket="/tmp/ani-cli-mpv-$$"
    if [ -S "$_socket" ]; then
        _pos=$(printf '{ "command": ["get_property", "time-pos"] }\n' | socat - UNIX-CONNECT:"$_socket" 2>/dev/null | sed -nE 's|.*"data":([0-9.]+).*|\1|p')
        [ -n "$_pos" ] && printf "%s" "$_pos" && return 0
    fi
    printf "0"
}

# called from the INT/HUP/TERM trap: persist the playback position of a
# running mpv before exiting, without clobbering history when no player is up
save_position_and_cleanup() {
    case "$player_function" in
        mpv*|flatpak_mpv)
            if [ -n "${_mpv_pid:-}" ] && kill -0 "$_mpv_pid" 2>/dev/null; then
                _pos=$(get_mpv_position)
                [ -n "$_pos" ] && [ "$_pos" != "0" ] && update_history "$_pos"
            fi
            ;;
    esac
    cleanup
}

resume_episode() {
    _hist_id="$1"
    _row=$(grep -F -- "$_hist_id" "$histfile")
    # only resume mid-episode if the saved position belongs to the episode about to play
    _hist_ep=$(printf "%s" "$_row" | cut -f1)
    [ -n "$_hist_ep" ] && [ "$_hist_ep" != "$ep_no" ] && return 1
    _pos=$(printf "%s" "$_row" | cut -f4)
    [ -z "$_pos" ] || [ "$_pos" = "0" ] && return 1
    printf "%.0f" "$_pos"
}

# call after anime_title is known: put downloads in their own per-anime folder
prepare_download_dir() {
    _dir="$(printf "%s" "$anime_title" | sed -e 's/^[[:space:]]*//; s/[[:space:]]*$//; s/[[:space:]]\{1,\}/ /g; s|/|_|g')"
    download_dir="$download_base_dir/$_dir"
    [ -n "$_dir" ] && mkdir -p "$download_dir" 2>/dev/null
}

# shellcheck disable=SC2086
download() {
    _dl_refr="${refr_flag#--referrer=}"
    [ -n "$sub_link" ] && $curl_exe -sL -A "$agent" -e "$_dl_refr" --max-time 10 $cipher_flag "$sub_link" -o "$download_dir/$2.vtt"
    case $1 in
        *m3u8*|*txt*)
            if command -v "yt-dlp" >/dev/null; then
                yt-dlp --referer "$_dl_refr" "$1" --no-skip-unavailable-fragments --fragment-retries infinite -N 4 -o "$download_dir/$2.mp4" && return 0
                warn "yt-dlp failed, trying ffmpeg"
            fi
            # -extension_picky needs ffmpeg >= 7.1: retry without it on older builds
            if ffmpeg -extension_picky 0 -referer "$_dl_refr" -loglevel error -stats -i "$1" -c copy "$download_dir/$2.mp4" \
                || ffmpeg -referer "$_dl_refr" -loglevel error -stats -i "$1" -c copy "$download_dir/$2.mp4"; then
                return 0
            fi
            # some embed variants name the mpeg-ts segments "*.woff2", which the
            # system ffmpeg's hls demuxer rejects outright; concatenate them with
            # curl (fresh connection per segment, referer set) and remux locally
            case $1 in
                *txt*)
                    warn "ffmpeg can't read this playlist directly; falling back to curl segment download"
                    _tmp_ts="/tmp/ani-cli-$$.ts"
                    _pl_file="/tmp/ani-cli-pl-$$.txt"
                    curl -fsSL --compressed -A "$agent" -H "Referer: $_dl_refr" "$1" | tr -d '\r' > "$_pl_file" || die "download failed: couldn't fetch playlist"
                    _base="$(printf '%s' "$1" | sed 's|[^/]*$||')"
                    while IFS= read -r _seg; do
                        case $_seg in '#'*|'') continue ;;
                        esac
                        _ok=0
                        _try=0
                        while [ "$_ok" = 0 ] && [ "$_try" -lt 5 ]; do
                            _try=$((_try + 1))
                            if ! curl -fsSL --compressed -A "$agent" -H "Referer: $_dl_refr" "${_base}${_seg}" -o "$_tmp_ts.part"; then
                                sleep 2
                                continue
                            fi
                            _sz=$(wc -c < "$_tmp_ts.part" 2>/dev/null || printf "0")
                            # the shard CDN rate-limits request bursts and then answers
                            # with truncated 200 bodies: treat those as failures and back off
                            if [ "${_sz:-0}" -lt 5000 ]; then
                                sleep 2
                                continue
                            fi
                            cat "$_tmp_ts.part" >> "$_tmp_ts"
                            _ok=1
                        done
                        [ "$_ok" = 0 ] && { rm -f "$_tmp_ts" "$_tmp_ts.part" "$_pl_file"; die "download failed on segment $_seg (shard throttled?)"; }
                    done < "$_pl_file"
                    rm -f "$_tmp_ts.part"
                    _sum=$(grep '#EXTINF' "$_pl_file" | sed 's/[^0-9.]//g' | awk '{s+=$1} END {print s + 0}')
                    rm -f "$_pl_file"
                    ffmpeg -loglevel error -y -i "$_tmp_ts" -c copy "$download_dir/$2.mp4"
                    _rc=$?
                    rm -f "$_tmp_ts"
                    [ "$_rc" != 0 ] && die "download failed"
                    if command -v ffprobe >/dev/null 2>&1 && [ -n "${_sum:-}" ] && [ "${_sum:-0}" -gt 0 ]; then
                        _dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$download_dir/$2.mp4" 2>/dev/null | cut -d. -f1)
                        [ -n "${_dur:-}" ] && [ "${_dur:-0}" -lt "$((_sum / 2))" ] && warn "File is much shorter than the source ($_dur s vs ~$_sum s) - the shard likely rate-limited the download; try again."
                    fi
                    return 0
                    ;;
            esac
            ;;
        *)
            # shellcheck disable=SC2086
            aria2c --referer="$_dl_refr" --enable-rpc=false --check-certificate=false --continue $iSH_DownFix --summary-interval=0 -x 16 -s 16 "$1" --dir="$download_dir" -o "$2.mp4" --download-result=hide
            ;;
    esac
}

android_mpv() {
    dir="/storage/emulated/0/mpv"
    file="$dir/mpv.config.mp4"
    if [ -w "${dir%*/mpv}" ]; then
        [ -d "${dir}" ] || mkdir "${dir}"
        printf "%s" "$3" | sed 's| --|\n|g; s|^--||g' >"$file"
    fi
    am start --user 0 -a android.intent.action.VIEW -d "$1" -n is.xyz.mpv/.MPVActivity -e "title" "$2" >/dev/null 2>&1
    unset dir file
}

play_episode() {
    _mpv_pid=""
    [ "$log_episode" = 1 ] && [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && command -v logger >/dev/null && logger -t ani-cli "${anime_title}${ep_no}"
    [ -z "$episode" ] && get_video_link
    case "$player_function" in
        mpv*|flatpak_mpv)
            if [ "$skip_intro" = 1 ]; then
                skip_flag="$(skip_opts)" || skip_flag=""
            fi
            ;;
    esac

    # wait for the previous player to close before starting a new one
    wait 2>/dev/null

    # resume position
    _resume_pos=""
    if [ "$resume_enabled" = 1 ]; then
        _resume_pos=$(resume_episode "$id")
        [ -n "$_resume_pos" ] && [ "$_resume_pos" != "0" ] && warn "Resuming from $_resume_pos seconds..."
    fi

    # mpv socket for position tracking
    _mpv_socket=""
    case "$player_function" in
        mpv*|flatpak_mpv)
            _mpv_socket="/tmp/ani-cli-mpv-$$"
            ;;
    esac

    # shellcheck disable=SC2086
    case "$player_function" in
        debug)
            printf "All links:\n%s\nSelected link:\n" "$links"
            printf "%s\n" "$episode"
            ;;
        mpv*)
            _mpv_args=""
            [ -n "$_mpv_socket" ] && rm -f "$_mpv_socket"
            [ -n "$_mpv_socket" ] && _mpv_args="--input-ipc-server=$_mpv_socket"
            [ -n "$_resume_pos" ] && [ "$_resume_pos" != "0" ] && _mpv_args="$_mpv_args --start=$_resume_pos"
            if [ "$no_detach" = 0 ]; then
                nohup $player_function $_mpv_args $skip_flag ${sub_link:+--sub-file="$sub_link"} --tls-verify=no --force-media-title="${anime_title} Episode ${ep_no}" "$episode" $refr_flag $bacc_flag $player_extra_flags >/dev/null 2>&1 &
                _mpv_pid=$!
            else
                $player_function $_mpv_args $skip_flag ${sub_link:+--sub-file="$sub_link"} $refr_flag $bacc_flag --tls-verify=no --force-media-title="${anime_title} Episode ${ep_no}" "$episode" $player_extra_flags
                mpv_exitcode=$?
                [ "$exit_after_play" = 1 ] && [ -z "$range" ] && [ "$auto_play" != 1 ] && exit "$mpv_exitcode"
            fi
            ;;
        android_mpv) "$player_function" "$episode" "${anime_title} Episode ${ep_no}" "--tls-verify=no $refr_flag $bacc_flag" $player_extra_flags 2>&1 & ;;
        android_vlc) nohup am start --user 0 -a android.intent.action.VIEW -d "$episode" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity -e "title" "${anime_title} Episode ${ep_no}" $player_extra_flags >/dev/null 2>&1 & ;;
        *iina*)
            _iina_refr_flag=""
            [ -n "$refr_flag" ] && _iina_refr_flag="--mpv-${refr_flag#--}"
            _sub_iina="$(printf "%s" "$sub_link" | sed 's|:|\\:|g')"
            if pgrep -f "IINA" >/dev/null 2>&1; then
                nohup $player_function --no-stdin --mpv-tls-verify=no ${_sub_iina:+--mpv-sub-files="$_sub_iina"} --mpv-force-media-title="${anime_title} Episode ${ep_no}" $_iina_refr_flag "$episode" $player_extra_flags >/dev/null 2>&1 &
            else
                nohup $player_function --no-stdin --mpv-tls-verify=no --keep-running ${_sub_iina:+--mpv-sub-files="$_sub_iina"} --mpv-force-media-title="${anime_title} Episode ${ep_no}" $_iina_refr_flag "$episode" $player_extra_flags >/dev/null 2>&1 &
            fi
            ;;
        flatpak_mpv)
            _flatpak_args=""
            [ -n "$_mpv_socket" ] && _flatpak_args="--input-ipc-server=$_mpv_socket"
            [ -n "$_resume_pos" ] && [ "$_resume_pos" != "0" ] && _flatpak_args="$_flatpak_args --start=$_resume_pos"
            nohup flatpak run io.mpv.Mpv $_flatpak_args ${sub_link:+--sub-file="$sub_link"} --tls-verify=no --force-media-title="${anime_title} Episode ${ep_no}" "$episode" $refr_flag $bacc_flag $player_extra_flags >/dev/null 2>&1 &
            _mpv_pid=$!
            ;;
        vlc*) nohup $player_function --http-referrer="${refr_flag#--referrer=}" --play-and-exit --meta-title="${anime_title} Episode ${ep_no}" "$episode" ${sub_link:+:input-slave="$sub_link"} $player_extra_flags >/dev/null 2>&1 & ;;
        *yncpla*) nohup $player_function "$episode" $player_extra_flags -- ${sub_link:+--sub-file="$sub_link"} --tls-verify=no --force-media-title="${anime_title} Episode ${ep_no}" $refr_flag >/dev/null 2>&1 & ;;
        download) "$player_function" "$episode" "Episode ${ep_no}" $player_extra_flags ;;
        catt) nohup catt cast "$episode" $player_extra_flags >/dev/null 2>&1 & ;;
        iSH)
            printf "\e]8;;vlc://%s\a~~~~~~~~~~~~~~~~~~~~\n~ Tap to open VLC ~\n~~~~~~~~~~~~~~~~~~~~\e]8;;\a\n" "$episode"
            sleep 5
            ;;
        *) nohup $player_function "$episode" $player_extra_flags >/dev/null 2>&1 & ;;
    esac
    replay="$episode"
    unset episode

    # save playback position
    case "$player_function" in
        mpv*|flatpak_mpv)
            if [ "$menu_program" != "fzf" ]; then
                _final_pos=0
                _wait_pid=""
                case "$no_detach" in
                    0) _wait_pid="$_mpv_pid" ;;
                    1) _final_pos="$(get_mpv_position)" ;;  # foreground: mpv already returned, grab once
                esac
                while [ -n "$_wait_pid" ] && kill -0 "$_wait_pid" 2>/dev/null; do
                    _pos=$(get_mpv_position)
                    [ -n "$_pos" ] && [ "$_pos" != "0" ] && _final_pos=$_pos
                    sleep 2
                done
                update_history "$_final_pos"
            fi
            ;;
        *)
            update_history "0"
            ;;
    esac
    [ "$menu_program" != "fzf" ] && wait
}

play() {
    start=$(printf "%s" "$ep_no" | grep -Eo '^(-1|[0-9]+(\.[0-9]+)?)')
    end=$(printf "%s" "$ep_no" | grep -Eo '(-1|[0-9]+(\.[0-9]+)?)$')
    [ "$start" = "-1" ] && ep_no=$(printf "%s" "$ep_list" | tail -n1) && unset start
    [ -z "$end" ] || [ "$end" = "$start" ] && unset start end
    [ "$end" = "-1" ] && end=$(printf "%s" "$ep_list" | tail -n1)
    line_count=$(printf "%s\n" "$ep_no" | wc -l | tr -d "[:space:]")
    if [ "$line_count" != 1 ] || [ -n "$start" ]; then
        [ -z "$start" ] && start=$(printf "%s\n" "$ep_no" | head -n1)
        [ -z "$end" ] && end=$(printf "%s\n" "$ep_no" | tail -n1)
        range=$(printf "%s\n" "$ep_list" | sed -nE "/^${start}\$/,/^${end}\$/p")
        [ -z "$range" ] && die "Invalid range!"

        # batch download progress
        if [ "$batch_mode" = 1 ]; then
            _total=$(printf "%s\n" "$range" | wc -l | tr -d " ")
            _count=0
            if [ "$parallel" -gt 1 ]; then
                info "Downloading $_total episodes with $parallel parallel jobs..."
                parallel_batch_dl "$parallel"
                return 0
            fi
        fi

        for i in $range; do
            tput clear 2>/dev/null
            ep_no=$i
            if [ "$batch_mode" = 1 ]; then
                _count=$((_count + 1))
                printf "\33[2K\r\033[1;34m[%s/%s] Downloading episode %s...\033[0m\n" "$_count" "$_total" "$ep_no"
                # skip if already downloaded
                _fname="Episode ${ep_no}.mp4"
                if [ -f "$download_dir/$_fname" ]; then
                    printf "\33[2K\r\033[1;33mSkipping episode %s (already exists)\033[0m\n" "$ep_no"
                    continue
                fi
            else
                info "Playing episode $ep_no..."
            fi
            [ "$i" = "$end" ] && unset range
            play_episode
        done
    elif [ "$auto_play" = 1 ] && [ "$batch_mode" != 1 ]; then
        # keep watching the series, automatically advancing to the next episode
        while :; do
            play_episode
            _next_ep="$(printf "%s\n" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}" 2>/dev/null)"
            [ -z "$_next_ep" ] && break
            ep_no="$_next_ep"
        done
    else
        play_episode
    fi
    # moves up to stored position and deletes to end
    [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && tput rc 2>/dev/null && tput ed 2>/dev/null
}

# run parallel downloads in batches of $1 concurrent episodes
parallel_batch_dl() {
    _jobs=0
    for i in $range; do
        ep_no=$i
        _fname="Episode ${ep_no}.mp4"
        if [ -f "$download_dir/$_fname" ]; then
            printf "\33[2K\r\033[1;33mSkipping episode %s (already exists)\033[0m\n" "$ep_no"
            continue
        fi
        [ "$i" = "$end" ] && unset range
        play_episode &
        _jobs=$((_jobs + 1))
        if [ "$_jobs" -ge "$1" ]; then
            wait
            _jobs=0
        fi
    done
    wait
}

